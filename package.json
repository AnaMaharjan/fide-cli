{
  "name": "@chris-test/cli",
  "version": "0.0.0-alpha.8",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChrisLally/fide-cli.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "fide": "dist/bin/fide.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "build:link": "node ./scripts/build.mjs --link",
    "check-types": "tsc --noEmit",
    "check:scope-model": "pnpm run build && node ./scripts/check-scope-model.mjs",
    "generate:docs": "node ./scripts/generate-docs/cli-reference.mjs",
    "check:generated:docs": "node ./scripts/generate-docs/cli-reference.mjs --check"
  },
  "dependencies": {
    "@chris-test/db": "workspace:*",
    "@chris-test/graph": "workspace:*",
    "@chris-test/graph-db": "workspace:*",
    "chokidar": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.9.3"
  }
}
